# Copy to ~/.config/hackathon-kit.env (chmod 600) and fill in. Never commit the real file.
HACKKIT_ORG=your-org                        # a GitHub organization you own; email invites need one
HACKKIT_TEMPLATE=your-org/hackathon-kit     # this kit, pushed and marked as a template repository

# Optional Discord wiring. Each webhook URL lets anyone post to that channel: keep them secret.
HACKKIT_DISCORD_INVITE=                     # e.g. https://discord.gg/abc123, shown to teammates
HACKKIT_DISCORD_PROGRESS_WEBHOOK=           # channel for pushes, pull requests, issues
HACKKIT_DISCORD_FEED_WEBHOOK=               # channel for agent activity (issue comments)
